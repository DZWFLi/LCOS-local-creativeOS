{
  "mcpServers": {
    "local-creative-os": {
      "command": "tools/lcos-agent/launch-local-creative-os-mcp.cmd",
      "args": [],
      "env": {
        "LCOS_CORE_URL": "http://127.0.0.1:43121",
        "LCOS_REPO_ROOT": ".",
        "LCOS_CORE_TOKEN_FILE": ".codex-runtime/local-core-token"
      }
    },
    "lcos-executor": {
      "command": "tools/lcos-agent/launch-lcos-executor-mcp.cmd",
      "args": [],
      "enabled": false,
      "env": {
        "LCOS_CORE_URL": "http://127.0.0.1:43121",
        "LCOS_REPO_ROOT": ".",
        "LCOS_CORE_TOKEN_FILE": ".codex-runtime/local-core-token"
      }
    }
  }
}
