diff -ruN '--exclude=node_modules' '--exclude=dist' /mnt/data/lcos_src_pristine/apps/web/tests/dropIntentMachine.test.ts /mnt/data/lcos_src_0bbe/apps/web/tests/dropIntentMachine.test.ts
