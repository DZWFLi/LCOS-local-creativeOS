    "@pagus-kit/renderer": "^0.1.1",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "^0.12.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.43.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
