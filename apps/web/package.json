{
  "name": "@local-creative-os/web",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "lint": "oxlint src tests",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run apps/web/tests",
    "smoke": "node ../../scripts/smoke.mjs"
  },
  "dependencies": {
    "@local-creative-os/contracts": "0.1.0",
    "@local-creative-os/ui": "0.1.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
