{
  "manifest_version": 3,
  "name": "LCOS Capture",
  "version": "0.1.0",
  "description": "把当前网页、图片、链接、选中文字直接收进 LCOS（Project Affinity 自动归属，不确定进 Staging）",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LCOS Capture",
    "default_popup": "src/popup.html"
  },
  "commands": {
    "capture-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture current page to LCOS"
    }
  }
}
