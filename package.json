{
  "name": "local-creative-os",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @local-creative-os/web",
    "build": "npm run build --workspace @local-creative-os/web",
    "lint": "npm run lint --workspace @local-creative-os/web",
    "preview": "npm run preview --workspace @local-creative-os/web",
    "typecheck": "npm run typecheck --workspace @local-creative-os/web",
    "test": "npm run test --workspace @local-creative-os/web",
    "smoke": "npm run smoke --workspace @local-creative-os/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
