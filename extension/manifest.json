{
  "manifest_version": 3,
  "name": "LCOS Capture",
  "version": "0.1.0",
  "description": "Capture pages, links, images, selections and screenshots into Local Creative OS.",
  "permissions": ["activeTab", "tabs", "contextMenus", "clipboardRead"],
  "host_permissions": ["http://127.0.0.1:43121/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "捕获到 LCOS"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
